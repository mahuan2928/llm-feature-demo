# Copy to .env and fill in:  cp .env.example .env

# Key YOUR backend must send as  X-API-Key: <this value>
# Invent any long random string — this protects the demo service itself.
SERVICE_API_KEY=change-me-to-a-long-random-string

# Your OpenAI API key (pay-as-you-go, not included)
OPENAI_API_KEY=

# Optional: which model to call
LLM_MODEL=gpt-4o-mini
